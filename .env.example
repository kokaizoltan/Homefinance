# Másold le .env néven, és töltsd ki az értékeket!

# Fejlesztéshez: DEBUG=True, élesben: DEBUG=False
DEBUG=True

# Generálás: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-dev-only-csere-elesben

# Vesszővel elválasztva
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Adatbázis -------------------------------------------------------------
# Fejlesztés (SQLite) – hagyd kommentben, ilyenkor a projekt gyökérben lévő
# db.sqlite3 fájlt használja:
# DATABASE_URL=sqlite:///db.sqlite3

# Éles / PostgreSQL (telepítsd: pip install "psycopg[binary]"):
# DATABASE_URL=postgres://homefinance:jelszo@localhost:5432/homefinance

# --- Éles biztonsági beállítások (DEBUG=False esetén) ---------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://pelda.hu
